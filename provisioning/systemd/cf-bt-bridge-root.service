[Unit]
Description=ClearFrame Bluetooth SPP Bridge
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/receiver/cftransmitter/tools/cf_bt_spp_bridge.py
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
